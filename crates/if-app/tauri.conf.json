{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IF",
  "version": "0.1.0",
  "identifier": "io.github.wep56.if",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../app" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../app" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IF",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
