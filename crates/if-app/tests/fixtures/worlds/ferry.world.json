  "lore": [
    {
      "id": "lore_port",
      "title": "老渡口",
      "content": "江边唯一的一处渡口，一条石阶伸进水里。船是一条用了十一年的乌篷船，船板被脚底磨得发亮。对岸是一道芦苇荡，过了芦苇荡才有人烟。",
      "keys": ["渡口", "船", "石阶"],
      "constant": true,
      "section": "world"
    },
    {
      "id": "lore_fog",
      "title": "江上的雾",
      "content": "入夜起雾，江面白得像有人铺了一层棉。雾里声音传得比平时远，一条船走没走，全靠听桨声。",
      "keys": ["雾", "江面"],
      "section": "scene"
    }
  ],

