        }
      ],
      "invariants": [
        {
          "id": "inv_rain_weather",
          "text": "持续期内，天气始终是暴雨",
          "check": { "kind": "semantic_only", "template": "q.beat.violates_rule" }
        }
      ],
      "constraints": ["q.beat.violates_rule"],
      "boundaries": [
        "第三十一天起，天气由世界推演，不受本条约束",
        "「暴雨」指持续强降雨，不排除短暂雨势转小——这算不算中断【用户确认】"
      ]
    },
    {
      "id": "rule_flood",
      "text": "江水位超过 28.5 米时，老城区开始内涝",
      "scope": [],
      "triggers": [
        {
          "id": "t_flood",
          "when": { "op": "compare", "prop": "p_river_level", "cmp": "gt", "value": 28.5 },
          "produces": { "kind": "candidate", "text": "老城区低洼处开始内涝，南门街首当其冲" }
        }
      ],
      "invariants": [
        {
          "id": "inv_flood_threshold",
          "text": "水位在 28.5 米以下时，老城区不应出现成规模的内涝",
          "check": { "kind": "semantic_only", "template": "q.beat.violates_rule" }
        }
      ],
      "constraints": ["q.beat.violates_rule"],
      "boundaries": ["28.5 米是水文站的警戒值，不是堤防的极限值"]
    },
    {
      "id": "rule_bulletin",
      "text": "对外通报必须由市应急办统一发布，任何个人不得先行公开数据",
      "scope": ["c_office"],
      "constraints": ["q.beat.violates_rule"],
      "boundaries": [
        "把数据交给记者、发到网上、或在自己家里写下这些数字，算不算「公开」【用户确认】",
        "水文人向本单位上报不在此列"
      ]
    }
  ],

  "lore": [
    {
      "id": "lore_town",
      "title": "临江市",
      "content": "长江中游的一座中型城市，人口约三百万。新城区依托山势而建，排水按三十年一遇设计；老城区则是沿江的旧工业带，街巷低矮，最靠江的南门街地面高程只有 24 米出头。梅雨季从六月下旬开始，往年最长不过十来天。",
      "keys": ["临江", "老城", "南门街"],
      "constant": true,
      "order": 0,
      "section": "world"
    },
    {
      "id": "lore_station",
      "title": "临江水文站",
      "content": "建在临江大桥下游两公里处的二层小楼，一楼是值班室和器材间，二楼摆着三台水位计终端。最老的一台还是九八年装上的。站里常年只有两个人。警戒水位 26.0 米，保证水位 29.5 米。",
      "keys": ["水文站", "值班室", "水位计"],
      "section": "scene"
    },
    {
      "id": "lore_reservoir",
      "title": "青石水库",
      "content": "上游四十公里，库容三点二亿立方米，建成于上世纪七十年代。它是下游三百万人的调蓄屏障，也是这座城市最不愿意被人细看的地方——库容曲线属于公开数据，但真正决定出库量的调度记录，几十年从没完整公开过。",
      "keys": ["青石", "水库", "出库"],
      "constant": false,
      "section": "world"
    },
    {
      "id": "lore_flood98",
      "title": "九八年那场水",
      "content": "那一年周望川还在部队。他所在的连队在临江大堤上守了十九天，最后三天是泡在齐腰深的水里过的。左腿的伤就是从那时候来的。他很少提这件事，但每年一到梅雨季，他的腿会比天气预报先疼。",
      "keys": ["九八", "旧伤", "抗洪"],
      "subjects": ["c_zhou"],
      "section": "character"
    },
    {
      "id": "lore_two_station",
      "title": "站里的两个人",
      "content": "周望川带过十几个徒弟，留下来的一向不多——水文站太闷，数据太静，年轻人待不住。沈知遥是第一个把整套记录格式重新誊了一遍的人，也是一年之内唯一没有请假回过家的一次。两个人的日常是沉默的，但沉默里有一种谁都没说出口的默契。",
      "keys": ["师徒", "站长", "见习"],
      "subjects": ["c_shen", "c_zhou"],
      "section": "character"
    },
    {
      "id": "lore_digest",
      "title": "那份平稳得过头的报表",
      "content": "青石水库的出库流量曲线，在最近五天的暴雨里平得像一条用尺子画出来的线。真正的调度会随降雨、库容、机组负荷一起抖动；一条完全不抖的曲线，只能说明有人替它抖过了。",
      "keys": ["出库数据", "曲线", "报表"],
      "visibility": "secret",
      "known_by": ["c_zhou"],
      "section": "world"
    },
    {
      "id": "lore_style",
      "title": "文风",
      "content": "白描，克制，不用形容词堆情绪。用具体的数字、体感与物理细节承载紧张感：雨声的密度、水漫过门槛的高度、旧伤在阴雨天的酸胀。人物不解释自己的动机，让行为与沉默说话。避免「不祥的预感」这类替读者下判断的句子。",
      "constant": true,
      "order": 100,
      "section": "style"
    }
  ],

