  "rules": [
    {
      "id": "rule_rain",
      "text": "本轮暴雨会持续三十天",
      "scope": [],
      "active_from_days": 1,
      "mechanics": [
        {
          "id": "m_rain_days",
          "target": "p_rain_days",
          "per": "step",
