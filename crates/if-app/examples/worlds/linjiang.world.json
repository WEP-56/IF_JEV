  "subjects": [
    {
      "id": "c_shen",
      "kind": "character",
      "name": "沈知遥",
      "aliases": ["小沈"],
      "profile": "二十三岁，水文站见习观测员，分配到临江不到一年。习惯用数字描述世界——水位、流速、误差范围——直到第一场暴雨让她第一次感到数字的无力。随身带一本防水记录本，字写得极小极密。",
      "voice": "「三号水位计，22.9。」她念数字的时候没有语气，像在读别人的事。",
      "tier": "foreground"
    },
    {
      "id": "c_zhou",
      "kind": "character",
      "name": "周望川",
      "aliases": ["老周"],
      "profile": "临江水文站站长，退伍工程兵，在这条江边守了二十七年。九八年抗洪时左腿落下旧伤，一到阴雨天就疼——比任何气象雷达都先知道天气要变。他知道这座城市每一条排水渠的走向，也知道哪一处的堤最薄。",
      "voice": "他说话很慢，一句一句往外挤，像是每句话都要先在心里称一遍分量。",
      "tier": "foreground",
      "shaped": true
    },
    {
      "id": "c_lin",
      "kind": "character",
      "name": "林曜",
      "aliases": [],
      "profile": "三十二岁的市应急办副主任。擅长在会议上把坏消息说成好消息，擅长让人觉得自己被重视了。他对上游水库的真实情况似乎知道得比报告里写的多——这一点他自己从不提起。",
      "voice": "「形势总体可控。」他说这句话的时候从不看人，而是看着窗外。",
      "tier": "active"
    },
    {
      "id": "c_reservoir",
      "kind": "location",
      "name": "青石水库",
      "aliases": ["上游水库"],
      "profile": "临江市上游四十公里的大型水库，负责调蓄与发电，同时是下游三十万人的最后一道屏障。库容曲线是公开数据，出库流量每六小时上报一次。",
      "tier": "dormant"
    },
    {
      "id": "c_office",
      "kind": "faction",
      "name": "市应急办",
      "aliases": [],
      "profile": "临江市防汛抗旱指挥部的实际执行机构。掌握物资调拨、预警发布与疏散决策的权力，也承担「不能引起恐慌」的默契。对外通报必须由它统一发布。",
      "tier": "dormant"
    }
  ],

